# Copy to .env for local development. Never commit .env.

# AWS credentials are read from the standard AWS provider chain:
# environment variables, ~/.aws credentials/config, SSO, web identity, or instance role.
# Do not put long-lived AWS secrets in this file for shared environments.

MANTLE_AWS_REGION=us-east-2
MANTLE_AWS_SERVICE=bedrock
MANTLE_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/openai/v1

MANTLE_PROXY_HOST=127.0.0.1
MANTLE_PROXY_PORT=4010
MANTLE_DEFAULT_MODEL=openai.gpt-5.5
MANTLE_REQUEST_TIMEOUT_SECONDS=120
MANTLE_MAX_BODY_BYTES=20971520
MANTLE_LOG_LEVEL=INFO

# Prompt cache observability: off | log | emf
# Mantle publishes no cache metric to CloudWatch, so the response usage object is
# the only source. Sniffing is read-only and does not alter forwarded bytes.
#   log  one structured log line per request (default, no behaviour change)
#   emf  Embedded Metric Format on stdout for the CloudWatch agent
MANTLE_CACHE_METRICS=log

# Optional. Set this before binding to anything other than localhost.
# Clients must send: Authorization: Bearer <value>
MANTLE_PROXY_API_KEY=

# Emergency-only escape hatch for private lab machines. Do not use in production.
MANTLE_ALLOW_INSECURE_REMOTE=false
